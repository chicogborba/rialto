DATABASE_URL="file:./dev.db"
PAYMENT_MODE="simulated"          # simulated | live (real sellers are paid on-chain, by their buyers' own wallets)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Live rail. Rialto holds no key and no funds on it: buyers sign their own payments, so all the server needs
# is the address its commission is paid to (a wallet you control; it must already hold a USDC account).
SOLANA_NETWORK="devnet"           # devnet | mainnet. Also set NEXT_PUBLIC_SOLANA_NETWORK to the same value at build time
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
PLATFORM_FEE_PAYTO=""             # where the commission goes: an address, never a key
SOLANA_PAY_TO=""                  # payout address of the PokéDex test seller and of the first-party integrations
# X402_FACILITATOR_URL=""         # default: x402.org on devnet, facilitator.payai.network on mainnet
# SOLANA_RPC_URL=""               # default: the public RPC of the network (use a private one on mainnet)

# Local testing only: `npm run x402:keys` fills these in. The buyer's key belongs on the BUYER's machine
# (the local signer, `npm run mcp`), not on a server.
SOLANA_WALLET_KEY=""              # the buyer's wallet: base58 secret key holding USDC, needs no SOL

# Platform
PLATFORM_FEE_BPS="500"            # 500 = 5% on top of the seller price
PLATFORM_MIN_FEE_MICRO="1000"     # floor: $0.001 per call
SECRETS_KEY=""                    # base64, 32 bytes (required in production): openssl rand -base64 32
ALLOW_PRIVATE_UPSTREAMS="0"       # 1 = allow http/localhost upstreams (development only)

# Production
ADMIN_TOKEN=""                    # bearer token allowed to reset the demo data (POST /api/reset); unset = nobody
INTERNAL_BASE_URL=""              # behind a proxy: http://127.0.0.1:3000

# Optional first-party integrations. Their headers are encrypted into the server database; never prefix these with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=""
TRIPO_API_KEY=""
FAL_KEY=""                          # fal.ai: images, sprites, video, 3D, music, sound effects, voices, transcription, language models
# the most these integrations may sell per 24 hours, in dollars: every call spends the keys above, even when the buyer pays in test credit
OPERATOR_DAILY_CAP_USD=5
# markup of Rialto's own integrations over what the upstream API (fal.ai) charges, in percent
OPERATOR_MARGIN_PCT=15
# accounts that can open /admin whatever their role (comma separated); more can be promoted from there
SUPERADMIN_EMAILS=""
