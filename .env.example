DATABASE_URL="file:./dev.db"
PAYMENT_MODE="simulated"          # simulated | live (x402 in USDC on Solana devnet, real sellers only)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Live rail (devnet). `npm run x402:keys -- --live` fills these in; never commit real keys.
X402_FACILITATOR_URL="https://x402.org/facilitator"
SOLANA_PAYER_SECRET_KEY=""        # wallet that pays sellers: base58 secret key, holds devnet USDC, needs no SOL
SOLANA_PAY_TO=""                  # payout address of the seeded PokéDex test seller
# SOLANA_RPC_URL="https://api.devnet.solana.com"

# Platform
PLATFORM_FEE_BPS="500"            # 500 = 5% on top of the seller price
PLATFORM_MIN_FEE_MICRO="1000"     # floor: $0.001 per call
SECRETS_KEY=""                    # base64, 32 bytes (required in production): openssl rand -base64 32
ALLOW_PRIVATE_UPSTREAMS="0"       # 1 = allow http/localhost upstreams (development only)

# Production
ADMIN_TOKEN=""                    # bearer token allowed to reset the demo data (POST /api/reset); unset = nobody
INTERNAL_BASE_URL=""              # behind a proxy: http://127.0.0.1:3000
LIVE_DAILY_CAP_USD="5"            # most the platform wallet pays sellers per 24 hours on the live rail

# Optional first-party integrations. Their headers are encrypted into the server database; never prefix these with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=""
TRIPO_API_KEY=""
FAL_KEY=""                          # fal.ai: images, sprites, video, 3D, music, sound effects, voices, transcription, language models
# the most these integrations may sell per 24 hours, in dollars: every call spends the keys above, even when the buyer pays in test credit
OPERATOR_DAILY_CAP_USD=5
