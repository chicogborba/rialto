{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rialto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "rialto-sim",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PAYMENT_MODE=simulated",
        "DATABASE_URL=file:./sim-test.db",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3110"
      ],
      "port": 3110
    },
    {
      "name": "rialto-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=file:./demo.db",
        "LIVE_DAILY_CAP_USD=20",
        "OPERATOR_DAILY_CAP_USD=50",
        "npm",
        "run",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "rialto-live-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=file:./live-test.db",
        "OPERATOR_DAILY_CAP_USD=1",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3120"
      ],
      "port": 3120
    },
    {
      "name": "rialto-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PAYMENT_MODE=simulated",
        "DATABASE_URL=file:./ui-test.db",
        "EMAIL_TRANSPORT=preview",
        "EMAIL_PREVIEW_DIR=.local/ui-emails",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3130"
      ],
      "port": 3130
    },
    {
      "name": "rialto-ui-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=file:./ui-live.db",
        "EMAIL_TRANSPORT=preview",
        "EMAIL_PREVIEW_DIR=.local/ui-emails",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3140"
      ],
      "port": 3140
    }
  ]
}