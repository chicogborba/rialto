{
  "name": "rialto-pitch-video",
  "version": "1.0.0",
  "description": "Rialto pitch video (Remotion + Three.js)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/three": "^0.186.0",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render RialtoPitch out/raw.mp4 && npm run master && node scripts/check-flicker.mjs out/rialto-pitch.mp4",
    "master": "ffmpeg -nostdin -y -loglevel error -i out/raw.mp4 -c:v copy -af loudnorm=I=-15:TP=-1.5:LRA=11 -c:a aac -b:a 192k -movflags +faststart out/rialto-pitch.mp4",
    "voiceover": "node --env-file=.env scripts/voiceover.mjs",
    "lint": "eslint src && tsc",
    "upgrade": "remotion upgrade",
    "hero": "remotion still HeroCard public/hero.png --image-format=png"
  }
}
